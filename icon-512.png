  <rect x="20" y="20" width="472" height="472" rx="90" fill="none" stroke="url(#grad)" stroke-width="12"/>
  <text x="50%" y="46%" font-family="Arial, sans-serif" font-size="170" font-weight="bold" fill="url(#grad)" text-anchor="middle" dominant-baseline="central">SF</text>
  <text x="50%" y="74%" font-family="Arial, sans-serif" font-size="38" font-weight="bold" fill="#f0f4f8" text-anchor="middle" letter-spacing="4">SANTA FE</text>
